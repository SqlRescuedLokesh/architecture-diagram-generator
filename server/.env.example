ANTHROPIC_API_KEY=
# Required ONLY for identity-linked keys (personal / service-account), which
# are not bound to a workspace — without it every call fails with a 400 asking
# for anthropic-workspace-id. Find the wrkspc_... id in the Console under
# Settings > Workspaces. Legacy "workspace" keys carry it implicitly; leave unset.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
# Optional overrides:
# PORT=3001
# ANTHROPIC_MODEL=claude-sonnet-4-6
# Total monthly budget for the whole site in USD (hosting + domain + API).
# MONTHLY_BUDGET_USD=20
# Your actual fixed hosting+domain cost per month; the rest of the budget
# is what's left over for Claude API calls before /api/generate starts
# returning 429s until next month.
# FIXED_MONTHLY_COST_USD=7
# Where usage counters are stored. Defaults to a file beside the server code,
# which is wiped on every deploy on hosts with an ephemeral filesystem — point
# this at a mounted volume to keep one continuous tally.
# USAGE_FILE_PATH=/data/usage.json
